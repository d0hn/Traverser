# ──────────────────────────────────────────────────────────────────────────────
# LLM providers (only needed for openai / anthropic — not required for github-copilot)
# ──────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────────────────────────────────
# GitHub (required for private repositories, strongly recommended for rate limits)
# ──────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ──────────────────────────────────────────────────────────────────────────────
# LLM configuration
# ──────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=github-copilot   # openai | anthropic | github-copilot
LLM_MODEL=claude-sonnet-4.6   # openai: gpt-4o | gpt-5.4  anthropic: claude-3-5-sonnet-20241022  github-copilot: claude-sonnet-4.6 | claude-opus-4.6 | gpt-5.2 | o3
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ──────────────────────────────────────────────────────────────────────────────
# Processing
# ──────────────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_LLM_REQUESTS=5   # concurrent LLM calls (watch your rate limits)
MAX_FILE_SIZE_KB=500             # skip files larger than this
OUTPUT_DIR=output
CACHE_DIR=.cache/traverser
CACHE_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────────
# Focus & update mode (optional — can also be passed as CLI flags)
# ──────────────────────────────────────────────────────────────────────────────
# FOCUS=src/services          # restrict analysis to a subpath prefix
#                             # equivalent to: traverser generate URL --focus src/services

# ──────────────────────────────────────────────────────────────────────────────
# Copilot CLI output
# ──────────────────────────────────────────────────────────────────────────────
# After running `traverser generate` or `traverser copilot`, copy the generated
# file to your repository root so GitHub Copilot picks it up automatically:
#
#   cp output/<owner_repo>/.github/copilot-instructions.md .github/copilot-instructions.md
#
# The file is regenerated on every run — do not edit it manually.
